{#- One ADR record -> OKF-conformant markdown (ADR 0047). GENERATED; edit the .yml.

    The body sections are emitted verbatim from the record, so every generated file is
    byte-identical to the markdown it replaced. The title stays in an H1 rather than
    moving into frontmatter as the librarian's shipped template does: this repository's
    observed dialect puts it there, every inbound citation resolves against it, and
    templates own presentation while the schema owns structure.

    Rendered with trim_blocks + lstrip_blocks, so every blank line below is literal. -#}
---
# GENERATED by okf_render.py from {{ rec.id.split('-')[-1] }}-{{ rec.slug }}.yml -- run `make adrs`.
# Edit the .yml; anything written here is lost on the next build.
type: Architecture Decision
title: {{ rec.title | yamlq }}
{% if rec.get('description') %}
description: {{ rec.description | yamlq }}
{% endif %}
{% if rec.get('tags') %}
tags: [{{ rec.tags | join(', ') }}]
{% endif %}
status: {{ rec.status }}
accepted_on: {{ rec.accepted_on }}
last_changed_on: {{ rec.last_changed_on }}
{% if rec.relates_to %}
relates_to:
{% for e in rec.relates_to %}
  - { relation: {{ e.relation }}, target: {{ e.target }} }
{% endfor %}
{% endif %}
generated: { by: {{ author }}, at: {{ rec.last_changed_on }}T00:00:00Z }
---

# {{ rec.id.split('-')[-1] }}: {{ rec.title }}

Status: {{ rec.status_note }}

## Context

{{ rec.body.context }}

## Decision

{{ rec.body.decision }}

## Consequences

{{ rec.body.consequences }}
{% if rec.get('lens') %}

