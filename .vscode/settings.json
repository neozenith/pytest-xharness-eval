// GENERATED by `meta vscode render` from manifest.yaml - do not edit.
// Add a repo to manifest.yaml and run `make fix`.
//
// The `jpai-*/` rule in .gitignore hides every child from this repo, and
// VS Code's auto-scan skips folders the enclosing repo ignores, so the
// children never reach Source Control at any scan depth.
// `git.scanRepositories` is the escape hatch: these paths are opened
// unconditionally, with no ignore rules applied.
{

  // Belt and braces: find anything added to the tree before the list above is
  // regenerated. Depth 2 is the deepest repo the manifest declares, plus one.
  "git.autoRepositoryDetection": true,
  "git.repositoryScanMaxDepth": 2,
  "git.repositoryScanIgnoredFolders": ["node_modules", ".venv", "tmp", ".git"],

  // Opening a child folder directly should still surface its repo rather than nothing.
  "git.openRepositoryInParentFolders": "always",

  // 2 nested repos plus this one; VS Code shows 10 by default.
  "scm.repositories.visible": 10,
  "scm.alwaysShowRepositories": true
}
